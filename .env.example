# ====================================================
# PARIS DAKAR GERENCIAL — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ====================================================

# ── Firebase (banco de dados principal) ──────────────
# Obtenha no Console Firebase > Configurações do Projeto
VITE_FIREBASE_API_KEY="sua-api-key-aqui"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="seu-sender-id"
VITE_FIREBASE_APP_ID="seu-app-id"

# ── Aplicação ─────────────────────────────────────────
VITE_APP_NAME="Paris Dakar Gerencial"
VITE_APP_URL="http://localhost:3000"

# ── E-mail do Administrador Master ────────────────────
# O e-mail que terá acesso administrativo garantido,
# mesmo com a coleção 'usuarios' vazia.
VITE_MASTER_ADMIN_EMAIL="seu-email-admin@gmail.com"

# ── Segurança API (servidor — não prefixar com VITE_) ─
# Gere um valor aleatório forte: openssl rand -hex 32
API_SECRET_KEY="gere-uma-chave-secreta-aleatoria"

# ── Outros (opcionais) ────────────────────────────────
# GEMINI_API_KEY="sua-chave-gemini"
