rules_version = '2';

// =============================================================================
// PARIS DAKAR GERENCIAL — Regras de segurança do Firestore
// =============================================================================
//
// O QUE ESTAS REGRAS SUBSTITUEM
// -----------------------------
// A versão anterior era `allow read, write: if true`. Isso NÃO é "sem login" —
// é sem porta. A `apiKey` do Firebase é pública por natureza: ela vai no bundle
// JavaScript e qualquer pessoa a lê no devtools em cinco segundos. Com a chave e
// a regra aberta, um estranho na internet consegue, sem conta nenhuma:
//
//   • baixar a base inteira (clientes, faturamento, títulos, extrato bancário);
//   • sobrescrever qualquer documento;
//   • apagar TODAS as coleções — e o Firestore não tem lixeira.
//
// As regras do Firestore são a ÚNICA barreira do lado do servidor neste
// sistema. Não há backend próprio: o app fala direto com o banco. Validação em
// React é conveniência de tela; quem impede a escrita indevida é este arquivo.
//
// COMO A AUTORIZAÇÃO FUNCIONA AQUI
// --------------------------------
// Duas etapas, ligadas por um interruptor, para poder apertar sem trancar
// ninguém do lado de fora:
//
//   ETAPA 1 (vale assim que você publica este arquivo)
//     Exige `request.auth != null`. Acaba o acesso anônimo. Continua entrando
//     todo mundo que já consegue logar hoje — risco de lockout: zero.
//
//   ETAPA 2 (você liga quando quiser, sem editar regra)
//     Crie o documento `config/acesso` com `{ exigir_lista: true }`. A partir
//     daí, só passa quem tiver um documento em `usuarios_index/{e-mail}`.
//     Fecha o buraco do autocadastro (ver "RESSALVA" abaixo).
//     Para voltar atrás: `exigir_lista: false` ou apague o documento.
//
// RESSALVA IMPORTANTE — POR QUE A ETAPA 1 SOZINHA NÃO BASTA
// ---------------------------------------------------------
// O provedor "E-mail/senha" do Firebase Auth aceita AUTOCADASTRO pelo SDK do
// navegador, e o próprio app usa isso no primeiro acesso
// (`createUserWithEmailAndPassword` em firebaseService.ts). Ou seja: um
// desconhecido pode criar uma conta e satisfazer `request.auth != null`.
// Por isso a Etapa 2 existe, e por isso ela deve ser ligada assim que a lista
// de usuários estiver conferida.
//
// O e-mail do ADMIN MASTER está fixo aqui de propósito: é o que garante que o
// dono do sistema entra mesmo com `usuarios_index` vazio, corrompido ou com o
// interruptor ligado por engano. Precisa bater com `MASTER_ADMIN_EMAIL` em
// src/services/firebaseService.ts.
//
// CUSTO
// -----
// `exists()`/`get()` contam como leitura. As funções abaixo fazem no máximo
// 2 lookups por requisição, dentro do limite de 10 do Firestore.
//
// PUBLICAR:  firebase deploy --only firestore:rules
// TESTAR:    console do Firebase → Firestore → Regras → "Simulador de regras"
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidade ────────────────────────────────────────────────────────
    function logado() {
      return request.auth != null;
    }

    function emailToken() {
      return logado() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    // NOTA DE SEGURANÇA: este e-mail DEVE ficar hardcoded aqui porque Firestore
    // Rules NÃO suportam variáveis de ambiente. Ele é o admin "à prova de
    // lockout" — garante acesso mesmo com a base vazia. Este mesmo e-mail
    // deve estar configurado em VITE_MASTER_ADMIN_EMAIL no .env do app.
    function ehMaster() {
      return emailToken() == 'onaeror@gmail.com';
    }

    // O interruptor da Etapa 2. Documento ausente = etapa 2 desligada.
    function exigeLista() {
      return exists(/databases/$(database)/documents/config/acesso)
        && get(/databases/$(database)/documents/config/acesso).data.exigir_lista == true;
    }

    function docAcesso() {
      return get(/databases/$(database)/documents/usuarios_index/$(emailToken()));
    }

    function naLista() {
      return emailToken() != ''
        && exists(/databases/$(database)/documents/usuarios_index/$(emailToken()));
    }

    /** Quem pode LER o sistema. */
    function autorizado() {
      return logado() && (ehMaster() || !exigeLista() || naLista());
    }

    /**
     * Papel do usuário. Fora da lista não há papel conhecido — devolve
     * 'desconhecido', que não casa com nenhuma checagem de papel.
     *
     * Consequência assumida enquanto a Etapa 2 estiver desligada: só o master
     * apaga coleção. É o comportamento seguro para uma operação sem volta.
     */
    function papel() {
      return ehMaster()
        ? 'admin'
        : (naLista() ? string(docAcesso().data.funcao) : 'desconhecido');
    }

    function ehAdmin() {
      return papel() == 'admin';
    }

    function ehGestorOuAdmin() {
      return papel() == 'admin' || papel() == 'gestor';
    }

    // ── Guardas de payload ────────────────────────────────────────────────
    //
    // Não substituem a validação de negócio (que vive no app): servem para o
    // caso em que alguém escreve DIRETO no banco com a chave pública, fora de
    // qualquer tela. Barram o absurdo — documento gigante, campo de tipo
    // errado, string de 1 MB.

    function tamanhoSao() {
      return request.resource.data.keys().size() <= 80;
    }

    function textoCurto(campo, max) {
      return !(campo in request.resource.data)
        || (request.resource.data[campo] is string && request.resource.data[campo].size() <= max);
    }

    /** Escrita comum de dado operacional: autorizado + payload não-absurdo. */
    function escritaValida() {
      return autorizado() && tamanhoSao();
    }

    // =====================================================================
    // COLEÇÕES DE CONTROLE DE ACESSO — as mais sensíveis do banco
    // =====================================================================

    /**
     * `usuarios` — quem entra e com qual papel.
     *
     * Leitura liberada para qualquer autenticado porque `fetchUsers()` roda
     * logo depois do login para descobrir o papel de quem entrou. Escrita é
     * SÓ do master: se um gestor pudesse editar aqui, bastaria trocar o
     * próprio `funcao` para 'admin' e a hierarquia inteira viraria decoração.
     *
     * A exceção do `master_admin` deixa `ensureMasterAdminRegistered()`
     * funcionar no primeiro login do dono, com a base ainda vazia.
     */
    match /usuarios/{userId} {
      allow read: if autorizado();
      allow create, update: if (ehMaster() || ehAdmin())
        && tamanhoSao()
        && textoCurto('email', 200)
        && textoCurto('nome', 200)
        && textoCurto('funcao', 20);
      allow delete: if (ehMaster() || ehAdmin()) && userId != 'master_admin';
    }

    /**
     * `usuarios_index` — a lista de acesso da Etapa 2, com o e-mail
     * normalizado como ID do documento (regra do Firestore não sabe consultar
     * por campo; só sabe olhar um ID).
     */
    match /usuarios_index/{emailId} {
      allow read: if logado();
      allow write: if (ehMaster() || ehAdmin())
        && tamanhoSao()
        && textoCurto('funcao', 20)
        && textoCurto('email', 200);
    }

    /** `config` — interruptores do sistema, incluindo o da Etapa 2. */
    match /config/{docId} {
      allow read: if logado();
      allow write: if ehMaster();
    }

    /**
     * `api_tokens` — segredos de integração.
     *
     * Fechado até para leitura de não-master. Token de API listado na tela é
     * token vazado: qualquer pessoa autenticada poderia copiá-lo e usar a
     * integração de fora do sistema, sem passar por login nenhum.
     */
    match /api_tokens/{tokenId} {
      allow read, write: if ehMaster();
    }

    // =====================================================================
    // BASES OPERACIONAIS
    // =====================================================================

    /**
     * GERENCIADOR DE TAREFAS E ROTINAS DIÁRIAS.
     */
    match /tarefas_rotinas/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    /**
     * COMPROVANTES, FRANCESAS E EXTRATOS DO DIA.
     */
    match /comprovantes_francesas/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    /**
     * TÍTULOS FINANCEIROS — contas a receber e a pagar.
     *
     * Escrita liberada para autorizado porque a baixa manual e a conciliação
     * são trabalho do dia a dia do analista. Já o DELETE é outra história:
     * `clearTitulos()` apaga a coleção inteira em lotes e não tem volta.
     * Isso fica com admin/gestor.
     */
    match /contas_a_receber/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    match /contas_a_pagar/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    match /contas_a_pagar_previsao/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    match /titulos_inadimplentes/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    /**
     * EXTRATO FINANCEIRO — a fonte de verdade da conciliação.
     *
     * É contra estes lançamentos que toda baixa é validada. Apagar um extrato
     * já conciliado deixa títulos "baixados" apontando para um lançamento que
     * não existe mais, e a auditoria do mês passa a não fechar sem que
     * ninguém entenda por quê. Delete: admin/gestor.
     */
    match /extrato_financeiro/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    /**
     * RESULTADO ECONÔMICO / FINANCEIRO / FLUXO DE CAIXA — números gerenciais
     * digitados e revisados pelo gestor, não importados. São a memória do
     * planejamento; refazer custa reunião, não reimportação.
     */
    match /resultado_economico/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida() && ehGestorOuAdmin();
      allow delete: if ehAdmin();
    }

    match /resultado_financeiro/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida() && ehGestorOuAdmin();
      allow delete: if ehAdmin();
    }

    match /fluxo_caixa/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida() && ehGestorOuAdmin();
      allow delete: if ehAdmin();
    }

    /** Faturamento, vendas e estoque — bases importadas, recriáveis. */
    match /faturamento/{docId} {
      allow read: if autorizado();
      allow write: if escritaValida();
    }
    match /faturamento_resumo/{docId} {
      allow read: if autorizado();
      allow write: if escritaValida();
    }
    match /faturamento_cliente/{docId} {
      allow read: if autorizado();
      allow write: if escritaValida();
    }
    match /vendas/{docId} {
      allow read: if autorizado();
      allow write: if escritaValida();
    }
    match /vendas_resumo/{docId} {
      allow read: if autorizado();
      allow write: if escritaValida();
    }
    match /estoque/{docId} {
      allow read: if autorizado();
      allow write: if escritaValida();
    }
    match /estoque_resumo/{docId} {
      allow read: if autorizado();
      allow write: if escritaValida();
    }

    /** Cadastros — carteira de clientes e equipe comercial. */
    match /clientes/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    match /vendedores/{docId} {
      allow read: if autorizado();
      allow create, update: if escritaValida();
      allow delete: if ehGestorOuAdmin();
    }

    /** Parâmetros de conciliação e preferências salvas do sistema. */
    match /configuracoes/{docId} {
      allow read: if autorizado();
      allow write: if escritaValida() && ehGestorOuAdmin();
    }

    // =====================================================================
    // FECHAMENTO PADRÃO
    // =====================================================================
    //
    // Coleção que ninguém previu não vira porta dos fundos. Se um módulo novo
    // precisar de uma coleção nova, a regra dela é escrita aqui em cima — de
    // propósito: obrigar a decisão explícita é o ponto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
